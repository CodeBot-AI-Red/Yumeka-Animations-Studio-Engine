<?xml version="1.0" encoding="utf-8"?>
<!--
    Hub: Novo Projeto — layout compacto, sem scroll, cabe em 16:9 landscape.
    Paddings e alturas reduzidos para que o conteudo inteiro apareca sem corte.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Header compacto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A1A2E"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&#127916;"
            android:textSize="18sp"
            android:gravity="center"
            android:background="#1E3A1E"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo Anime"
                android:textColor="#90EEB8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crie seu projeto no YASE"
                android:textColor="#5C8A70"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divisor -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2A" />

    <!-- Body compacto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do anime:"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edt_anime_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Ex. Naruto, Dragon Ball, One Piece..."
            android:textColor="#FFFFFF"
            android:textColorHint="#444444"
            android:textSize="13sp"
            android:background="#222222"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:inputType="textCapWords"
            android:maxLength="64" />

        <TextView
            android:id="@+id/txt_error_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF6B35"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:visibility="gone" />

        <!-- Estrutura info compacta -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estrutura criada automaticamente:"
            android:textColor="#90EEB8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#128193; NomeAnime/  &#128194; Plugins  &#128194; Temporadas  &#128216; yase.project"
            android:textColor="#555555"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="12dp" />

        <!-- Botoes lado a lado como Godot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/btn_cancelar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textColor="#888888"
                android:textSize="13sp"
                android:gravity="center"
                android:background="#1A1A1A"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_criar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Criar"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#90EEB8" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
