<?xml version="1.0" encoding="utf-8"?>
<!-- Um item de Frame na lista de frames do painel esquerdo do editor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="6dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Thumbnail do frame -->
    <View
        android:id="@+id/frame_thumbnail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#22222E" />

    <!-- Info: nome e tempo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/frame_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frame 1"
            android:textColor="#F0F0F5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/frame_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 - 0:03"
            android:textColor="#606078"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Menu do frame -->
    <TextView
        android:id="@+id/frame_menu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="&#8942;"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#606078" />

</LinearLayout>
