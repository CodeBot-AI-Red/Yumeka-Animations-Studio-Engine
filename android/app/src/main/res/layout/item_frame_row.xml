<?xml version="1.0" encoding="utf-8"?>
<!-- Item de Frame/Keyframe na lista do painel de propriedades -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Thumbnail quadrado do frame -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/frame_normal_border">

        <ImageView
            android:id="@+id/frame_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#0D1527" />

    </FrameLayout>

    <!-- Info: nome e tempo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/frame_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frame 1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/frame_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 - 0:03"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Menu ··· -->
    <TextView
        android:id="@+id/frame_menu"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="&#8942;"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

</LinearLayout>
