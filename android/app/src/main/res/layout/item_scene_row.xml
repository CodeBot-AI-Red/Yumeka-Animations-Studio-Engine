<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha de Cena no painel de cenas do editor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Thumbnail da cena -->
    <View
        android:id="@+id/scene_thumbnail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#22222E" />

    <!-- Info: nome e tempo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="6dp">

        <TextView
            android:id="@+id/scene_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cena 1"
            android:textColor="#F0F0F5"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scene_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 - 00:15"
            android:textColor="#606078"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- Menu da cena -->
    <TextView
        android:id="@+id/scene_menu"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:text="&#8942;"
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="#606078" />

</LinearLayout>
