<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor Layout — Yumeka Animations Studio Engine
  Estrutura:
  ┌─────────────────────────────────────────────────────────────────────┐
  │  TOPBAR: ☰ · 🌸 YUMEKA · │ · breadcrumb ······ ● Salvo · ⚙ · [Quadros] ▶ ⛶ ···  │
  ├──────┬──────────────────────────────────────────────┬──────────────┤
  │ TOOL │                  CANVAS                      │    PAINEL    │
  │  │   │   ┌──────────────────────────────────────┐  │  Propriedades│
  │  ↑   │   │           FrameCanvasView            │  │  do Frame    │
  │  ✏  │   │                                      │  │  ──────────  │
  │  ⊟   │   │                                      │  │  Frame 12    │
  │  □   │   └──────────────────────────────────────┘  │  Duração     │
  │  ○   ├──────────────────────────────────────────────┤  ──────────  │
  │  T   │ Frames [250] [9][10][11][12*][13][14][15] ⊕ ⊟│  Animação ˅ │
  │  🗂  ├──────────────────────────────────────────────┤  Camadas  ˅ │
  │      │ ◇Keyframes ▶ ──◇──────────────◇──────── 📈˅ │  Keyframes ˄ │
  └──────┴──────────────────────────────────────────────┴──────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <!-- ══════════════════════════════════════════════════════════
         TOPBAR
         ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/editor_topbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_card"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ☰ Menu / toggle sidebar -->
        <TextView
            android:id="@+id/btn_toggle_left"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&#9776;"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 🌸 Logo YUMEKA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:text="&#127800;"
                android:textSize="17sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YUMEKA"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Animations Studio Engine"
                    android:textColor="@color/text_muted"
                    android:textSize="7sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divisor vertical -->
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="@color/surface_card_border"
            android:layout_marginEnd="12dp" />

        <!-- Breadcrumb: nome projeto › EP-1 › Frame N / Total -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:text="&#128193;"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txt_project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projeto"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" &#8964;"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_season_episode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EP-1  ›  Frame 1 / 250"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- ● Salvo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="10dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_green"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salvo"
                android:textColor="@color/accent_green"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ⚙ Configurações -->
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#9881;"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- [🖼 Quadros] botão roxo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/accent_purple"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:text="&#128444;"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/tab_quadros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quadros"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ▶ Play circular -->
        <TextView
            android:id="@+id/btn_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#9654;"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@color/surface_card2"
            android:layout_marginEnd="4dp" />

        <!-- ⛶ Tela cheia -->
        <TextView
            android:id="@+id/btn_toggle_right"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#9974;"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="4dp" />

        <!-- ··· Mais opções -->
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="&#8943;"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- ID oculto mantido para o Fragment -->
        <TextView
            android:id="@+id/btn_editor_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════
         CORPO PRINCIPAL: toolbar | canvas+strip+timeline | painel
         ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/editor_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/editor_topbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ══════════════════════════════════════════════════
             TOOLBAR DE FERRAMENTAS (esquerda, estreita)
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/editor_toolbar"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@color/surface_card"
            android:elevation="2dp">

            <!-- Seleção (ativo por padrão com fundo roxo) -->
            <TextView
                android:id="@+id/tool_select"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#8598;"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:gravity="center"
                android:background="@color/accent_purple"
                android:layout_marginBottom="4dp" />

            <!-- Pincel -->
            <TextView
                android:id="@+id/tool_brush"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9999;"
                android:textColor="@color/text_secondary"
                android:textSize="17sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="4dp" />

            <!-- Borracha -->
            <TextView
                android:id="@+id/tool_eraser"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9638;"
                android:textColor="@color/text_secondary"
                android:textSize="17sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="4dp" />

            <!-- Retângulo -->
            <TextView
                android:id="@+id/tool_rect"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9645;"
                android:textColor="@color/text_secondary"
                android:textSize="17sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="4dp" />

            <!-- Elipse -->
            <TextView
                android:id="@+id/tool_ellipse"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9711;"
                android:textColor="@color/text_secondary"
                android:textSize="17sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="4dp" />

            <!-- Texto -->
            <TextView
                android:id="@+id/tool_text"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="T"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="4dp" />

            <!-- Espaçador -->
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Camadas (fixado ao fundo) -->
            <TextView
                android:id="@+id/tool_layers"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#128466;"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             COLUNA CENTRAL: canvas + strip + timeline
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/surface_dark">

            <!-- ── CANVAS ──────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/canvas_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#0B0B12">

                <!-- Canvas de frames da engine -->
                <com.yumeka.anime.engine.views.FrameCanvasView
                    android:id="@+id/frame_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Badge resolução (canto superior esquerdo) -->
                <TextView
                    android:id="@+id/txt_canvas_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1920 × 1080"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="#99000000"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp" />

                <!-- Badge zoom (canto superior direito) -->
                <TextView
                    android:id="@+id/txt_canvas_zoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="#99000000"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp" />

            </FrameLayout>

            <!-- ── STRIP DE FRAMES ─────────────────────────── -->
            <LinearLayout
                android:id="@+id/strip_frames"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface_card"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:elevation="2dp">

                <!-- Label "🖼 Frames" + contador -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:text="&#128444;"
                        android:textSize="11sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frames"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/txt_frame_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="250"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@color/surface_card2"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />

                </LinearLayout>

                <!-- RecyclerView horizontal de thumbnails -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_frames"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:scrollbars="none" />

                <!-- Botões: + duplicar deletar ··· -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/btn_frame_add"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="+"
                        android:textColor="@color/text_muted"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:background="@color/surface_card2"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/btn_frame_duplicate"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="&#8853;"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@color/surface_card2"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/btn_frame_delete"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="&#128465;"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@color/surface_card2"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/btn_frame_more"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="&#8943;"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@color/surface_card2" />

                </LinearLayout>

            </LinearLayout>

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_card_border" />

            <!-- ── TIMELINE / KEYFRAMES ────────────────────── -->
            <LinearLayout
                android:id="@+id/strip_keyframes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- ◇ Keyframes label (roxo) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@color/accent_purple"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9671;"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keyframes"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- ▶ play da timeline -->
                <TextView
                    android:id="@+id/btn_tl_play"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="&#9654;"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@color/surface_card2"
                    android:layout_marginEnd="10dp" />

                <!-- Diamante de início -->
                <TextView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:text="&#9671;"
                    android:textColor="@color/surface_card_border"
                    android:textSize="10sp"
                    android:gravity="center" />

                <!-- Trilho da timeline com playhead -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <!-- Linha do trilho -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="center"
                        android:background="@color/surface_card_border" />

                    <!-- Playhead roxo (posição ~38%) -->
                    <View
                        android:id="@+id/tl_playhead"
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="80dp"
                        android:background="@color/accent_purple" />

                    <!-- Diamante de meio -->
                    <TextView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:text="&#9671;"
                        android:textColor="@color/surface_card_border"
                        android:textSize="10sp"
                        android:gravity="center" />

                </FrameLayout>

                <!-- Diamante de fim -->
                <TextView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:text="&#9671;"
                    android:textColor="@color/surface_card_border"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp" />

                <!-- Modo Normal dropdown -->
                <LinearLayout
                    android:id="@+id/btn_tl_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@color/surface_card2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#128200;"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" &#8964;"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             PAINEL DIREITO — Propriedades do Frame
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/panel_properties"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface_card"
            android:elevation="3dp">

            <!-- Cabeçalho do painel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@color/surface_card">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:text="&#128444;"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginEnd="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Propriedades do Frame"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_card_border" />

            <!-- Preview do frame selecionado -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@color/surface_card2">

                <!-- Miniatura do frame (proporção 16:9) -->
                <ImageView
                    android:id="@+id/img_frame_preview"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:scaleType="centerCrop"
                    android:background="#0D1527" />

                <!-- Badge no canto: número do frame -->
                <TextView
                    android:id="@+id/txt_frame_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frame 1"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:background="#99000000"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="4dp" />

            </FrameLayout>

            <!-- Rodapé da miniatura: nome + duração + ··· -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginTop="-12dp"
                android:background="@color/surface_card2"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_frame_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frame 1"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_frame_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duração: 00:04"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="&#8942;"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:gravity="center" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_card_border"
                android:layout_marginTop="8dp" />

            <!-- Seção: Animação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:text="&#10024;"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Animação"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8964;"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_card_border" />

            <!-- Seção: Camadas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:text="&#128466;"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camadas"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8964;"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_card_border" />

            <!-- Seção: Keyframes (expandida) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:text="&#9671;"
                    android:textColor="@color/accent_purple"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Keyframes"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Seta para cima (expandido) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8963;"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Botão + Adicionar Keyframe -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@color/accent_purple"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/btn_add_keyframe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Adicionar Keyframe"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
