<?xml version="1.0" encoding="utf-8"?>
<!--
    Editor principal do YASE — layout landscape 16:9
    Estrutura inspirada na interface colorida de referencia:
      - Topo: barra de titulo + tabs Quadros/3D + botao Play
      - Esquerda: painel de Keyframes + lista de Frames da Cena ativa
      - Centro: canvas de animacao/preview do episodio
      - Direita: ferramentas (selecao, mover, rotacao, crop, pincel, cor, balde)
      - Rodape: tabs de ferramentas (Modelos, Elementos, Texto, Galeria, Camera, Efeitos...)
      - Direita superior: painel de Cenas
      - Direita inferior: painel de Camadas

    Conceitos:
      Cenas    — secoes/partes do episodio (gerenciadas logicamente, sem pasta fisica)
      Frames   — quadros pertencentes a Cena selecionada
      Keyframes— pontos de animacao dentro de um Frame (nao sao pastas)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F13">

    <!-- ===================================================================
         TOPBAR: titulo, tabs Quadros/3D, Play, fullscreen
         =================================================================== -->
    <LinearLayout
        android:id="@+id/editor_topbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A1A2E"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Voltar -->
        <TextView
            android:id="@+id/btn_editor_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8592;"
            android:textColor="#A0A0B8"
            android:textSize="18sp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp" />

        <!-- Nome do projeto + episodio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_project_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Projeto sem titulo"
                android:textColor="#F0F0F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/txt_season_episode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temporada 1 • Episodio 1"
                android:textColor="#606078"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#2A2A3A"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Tab: Quadros -->
        <TextView
            android:id="@+id/tab_quadros"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="&#128247;  Quadros"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#9B6DFF"
            android:layout_marginEnd="4dp" />

        <!-- Tab: 3D -->
        <TextView
            android:id="@+id/tab_3d"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="&#9650;  3D"
            android:textColor="#A0A0B8"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#22222E"
            android:layout_marginEnd="8dp" />

        <!-- Botao Play -->
        <TextView
            android:id="@+id/btn_play"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&#9654;"
            android:textColor="#F0F0F5"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#2A2A3A"
            android:layout_marginEnd="4dp" />

        <!-- Fullscreen -->
        <TextView
            android:id="@+id/btn_fullscreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&#x26F6;"
            android:textColor="#A0A0B8"
            android:textSize="14sp"
            android:gravity="center"
            android:background="#22222E" />

    </LinearLayout>

    <!-- ===================================================================
         PAINEL ESQUERDO: Keyframes + lista de Frames da Cena ativa
         =================================================================== -->
    <LinearLayout
        android:id="@+id/panel_left"
        android:layout_width="180dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#151520"
        app:layout_constraintTop_toBottomOf="@id/editor_topbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Cabecalho Keyframes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#9B6DFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Keyframes"
                android:textColor="#F0F0F5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Botoes Adicionar / Excluir / Escolher keyframe -->
        <TextView
            android:id="@+id/btn_add_keyframe"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="+ Adicionar keyframe"
            android:textColor="#F0F0F5"
            android:textSize="11sp"
            android:gravity="center"
            android:background="#9B6DFF"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/btn_del_keyframe"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Excluir keyframe"
            android:textColor="#A0A0B8"
            android:textSize="11sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/btn_choose_keyframe"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Escolher keyframes"
            android:textColor="#A0A0B8"
            android:textSize="11sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp" />

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#2A2A3A" />

        <!-- Lista de Frames da Cena ativa -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_frames"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp" />

        <!-- Botao adicionar Frame -->
        <TextView
            android:id="@+id/btn_add_frame"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="+ Adicionar Frame"
            android:textColor="#9B6DFF"
            android:textSize="11sp"
            android:gravity="center"
            android:background="#1A1A2A"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ===================================================================
         FERRAMENTAS (coluna vertical, lado esquerdo do canvas)
         =================================================================== -->
    <LinearLayout
        android:id="@+id/panel_tools"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:background="#12121C"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/editor_topbar"
        app:layout_constraintStart_toEndOf="@id/panel_left"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Selecionar -->
        <TextView
            android:id="@+id/tool_select"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#8630;"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#9B6DFF"
            android:layout_marginBottom="4dp" />

        <!-- Mover -->
        <TextView
            android:id="@+id/tool_move"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#10021;"
            android:textColor="#A0A0B8"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginBottom="4dp" />

        <!-- Rotacao -->
        <TextView
            android:id="@+id/tool_rotate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#8635;"
            android:textColor="#A0A0B8"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginBottom="4dp" />

        <!-- Crop -->
        <TextView
            android:id="@+id/tool_crop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#9634;"
            android:textColor="#A0A0B8"
            android:textSize="14sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginBottom="4dp" />

        <!-- Divisor -->
        <View
            android:layout_width="24dp"
            android:layout_height="0.5dp"
            android:background="#2A2A3A"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp" />

        <!-- Pincel (Desenho — pertence ao Quadro/Frame) -->
        <TextView
            android:id="@+id/tool_brush"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#9998;"
            android:textColor="#A0A0B8"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginBottom="4dp" />

        <!-- Cor -->
        <TextView
            android:id="@+id/tool_color"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#9679;"
            android:textColor="#4ADE80"
            android:textSize="20sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginBottom="4dp" />

        <!-- Balde de tinta -->
        <TextView
            android:id="@+id/tool_fill"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#128024;"
            android:textColor="#A0A0B8"
            android:textSize="14sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginBottom="4dp" />

        <!-- Mais ferramentas -->
        <TextView
            android:id="@+id/tool_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#8943;"
            android:textColor="#606078"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#12121C" />

    </LinearLayout>

    <!-- ===================================================================
         CANVAS CENTRAL: exibe o 3D/quadro ativo e roda o episodio no play
         =================================================================== -->
    <FrameLayout
        android:id="@+id/canvas_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#111118"
        app:layout_constraintTop_toBottomOf="@id/editor_topbar"
        app:layout_constraintStart_toEndOf="@id/panel_tools"
        app:layout_constraintEnd_toStartOf="@id/panel_right"
        app:layout_constraintBottom_toTopOf="@id/bottom_toolbar">

        <!-- Canvas de animacao / preview -->
        <View
            android:id="@+id/canvas_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#111118" />

        <!-- Botoes de acao flutuantes abaixo do canvas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp">

            <TextView
                android:id="@+id/btn_alinhar_ia"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="&#128247;  alinhar com IA"
                android:textColor="#F0F0F5"
                android:textSize="12sp"
                android:gravity="center"
                android:background="#1E1E2E"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_editar_video"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="&#127909;  Editar Video"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#9B6DFF" />

        </LinearLayout>

    </FrameLayout>

    <!-- ===================================================================
         PAINEL DIREITO: Cenas (topo) + Camadas (baixo)
         =================================================================== -->
    <LinearLayout
        android:id="@+id/panel_right"
        android:layout_width="180dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#151520"
        app:layout_constraintTop_toBottomOf="@id/editor_topbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_toolbar">

        <!-- CENAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:background="#1A1A2E">

                <TextView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#4ADE80" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cenas"
                    android:textColor="#F0F0F5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/btn_add_scene"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="+"
                    android:textColor="#4ADE80"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="#1E2E1E" />

            </LinearLayout>

            <!-- Lista de Cenas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_scenes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- Divisor entre Cenas e Camadas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#2A2A3A" />

        <!-- CAMADAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:background="#1A1A2E">

                <TextView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#FBBF24" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camadas"
                    android:textColor="#F0F0F5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />

                <!-- Visibilidade global -->
                <TextView
                    android:id="@+id/btn_layers_visibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="&#128065;"
                    android:textSize="14sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Camadas fixas do episodio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <!-- Personagem -->
                <include layout="@layout/item_layer_row"
                    android:id="@+id/layer_personagem" />

                <!-- 3D -->
                <include layout="@layout/item_layer_row"
                    android:id="@+id/layer_3d" />

                <!-- Fundo -->
                <include layout="@layout/item_layer_row"
                    android:id="@+id/layer_fundo" />

                <!-- Desenho -->
                <include layout="@layout/item_layer_row"
                    android:id="@+id/layer_desenho" />

                <!-- Efeito -->
                <include layout="@layout/item_layer_row"
                    android:id="@+id/layer_efeito" />

                <!-- Texto -->
                <include layout="@layout/item_layer_row"
                    android:id="@+id/layer_texto" />

                <!-- Audio -->
                <include layout="@layout/item_layer_row"
                    android:id="@+id/layer_audio" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ===================================================================
         TOOLBAR INFERIOR: Modelos, Elementos, Texto, Galeria, Camera, Efeitos...
         =================================================================== -->
    <HorizontalScrollView
        android:id="@+id/bottom_toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#12121C"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/panel_left"
        app:layout_constraintEnd_toStartOf="@id/panel_right">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/btool_modelos"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#128432;" android:textSize="18sp" android:gravity="center" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Modelos" android:textColor="#9B6DFF" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_elementos"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#10029;" android:textSize="18sp" android:gravity="center"
                    android:textColor="#A0A0B8" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Elementos" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_texto"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="T" android:textSize="18sp" android:gravity="center"
                    android:textColor="#A0A0B8" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Texto" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_galeria"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#128247;" android:textSize="18sp" android:gravity="center" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Galeria" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_camera"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#127909;" android:textSize="18sp" android:gravity="center" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Camera" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_efeitos"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#10024;" android:textSize="18sp" android:gravity="center" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Efeitos" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_particulas"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#10052;" android:textSize="18sp" android:gravity="center" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Particulas" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_luz"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#9728;" android:textSize="18sp" android:gravity="center"
                    android:textColor="#FBBF24" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Luz" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_sombras"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#9681;" android:textSize="18sp" android:gravity="center" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sombras" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btool_fundo"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#127757;" android:textSize="18sp" android:gravity="center" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fundo" android:textColor="#606078" android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
