<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F13">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOPBAR -->
        <LinearLayout
            android:id="@+id/editor_topbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Voltar -->
            <TextView
                android:id="@+id/btn_editor_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#8592;"
                android:textColor="#A0A0B8"
                android:textSize="20sp"
                android:gravity="center" />

            <!-- Abrir painel de quadros -->
            <TextView
                android:id="@+id/btn_toggle_left"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9776;"
                android:textColor="#9B6DFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginStart="2dp" />

            <!-- Nome projeto -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/txt_project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projeto"
                    android:textColor="#F0F0F5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/txt_season_episode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temporada 1 Episodio 1"
                    android:textColor="#606078"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- Tab Quadros -->
            <TextView
                android:id="@+id/tab_quadros"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Quadros"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="#9B6DFF"
                android:layout_marginEnd="3dp" />

            <!-- Play -->
            <TextView
                android:id="@+id/btn_play"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="&#9654;"
                android:textColor="#F0F0F5"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#2A2A3A"
                android:layout_marginEnd="3dp" />

            <!-- Toggle drawer direito (Cenas/Camadas) -->
            <TextView
                android:id="@+id/btn_toggle_right"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9783;"
                android:textColor="#4ADE80"
                android:textSize="16sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Canvas -->
        <FrameLayout
            android:id="@+id/canvas_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#16162A"
            app:layout_constraintTop_toBottomOf="@id/editor_topbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- View de desenho: retangulo branco + restricao de toque -->
            <com.yumeka.anime.engine.views.FrameCanvasView
                android:id="@+id/canvas_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Estado vazio -->
            <LinearLayout
                android:id="@+id/canvas_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127800;"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhum frame selecionado"
                    android:textColor="#4A4A6A"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abra o painel lateral e crie sua primeira cena"
                    android:textColor="#35354A"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />

            </LinearLayout>

            <!-- Toolbar de pincel: visivel so com frame ativo, fixada no RODAPE do canvas -->
            <LinearLayout
                android:id="@+id/brush_toolbar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#CC0F0F18"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <!-- Pincel -->
                <TextView
                    android:id="@+id/brush_btn_pencil"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="&#9998;"
                    android:textColor="#9B6DFF"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:background="#22223A"
                    android:layout_marginEnd="4dp" />

                <!-- Borracha -->
                <TextView
                    android:id="@+id/brush_btn_eraser"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="&#9633;"
                    android:textColor="#A0A0B8"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:background="#22222E"
                    android:layout_marginEnd="4dp" />

                <!-- Limpar -->
                <TextView
                    android:id="@+id/brush_btn_clear"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="&#128465;"
                    android:textColor="#FF6B6B"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:background="#22222E"
                    android:layout_marginEnd="10dp" />

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="22dp"
                    android:background="#3A3A5A"
                    android:layout_marginEnd="10dp" />

                <!-- Tamanho fino -->
                <TextView
                    android:id="@+id/brush_size_small"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="&#9679;"
                    android:textColor="#A0A0B8"
                    android:textSize="7sp"
                    android:gravity="center"
                    android:background="#22222E"
                    android:layout_marginEnd="4dp" />

                <!-- Tamanho medio -->
                <TextView
                    android:id="@+id/brush_size_medium"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="&#9679;"
                    android:textColor="#9B6DFF"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="#22223A"
                    android:layout_marginEnd="4dp" />

                <!-- Tamanho grosso -->
                <TextView
                    android:id="@+id/brush_size_large"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="&#9679;"
                    android:textColor="#A0A0B8"
                    android:textSize="21sp"
                    android:gravity="center"
                    android:background="#22222E"
                    android:layout_marginEnd="10dp" />

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="22dp"
                    android:background="#3A3A5A"
                    android:layout_marginEnd="10dp" />

                <!-- Swatch cor atual -->
                <TextView
                    android:id="@+id/brush_color_swatch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#FF000000"
                    android:text=""
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <!-- Espacador -->
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            </LinearLayout>


        </FrameLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER ESQUERDO: Keyframes + Frames -->
    <LinearLayout
        android:id="@+id/panel_left"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5151520"
        android:elevation="8dp"
        android:translationX="-260dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#9B6DFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quadros"
                android:textColor="#F0F0F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/btn_close_left"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="&#10005;"
                android:textColor="#606078"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#2A2A3A" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_frames"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/btn_add_frame"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="+ Adicionar Frame"
            android:textColor="#9B6DFF"
            android:textSize="12sp"
            android:gravity="center"
            android:background="#1A1A2A" />

    </LinearLayout>

    <!-- DRAWER DIREITO: Cenas + Camadas -->
    <LinearLayout
        android:id="@+id/panel_right"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5151520"
        android:elevation="8dp"
        android:layout_gravity="end"
        android:translationX="260dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#4ADE80" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cenas"
                android:textColor="#F0F0F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/btn_add_scene"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="+"
                android:textColor="#4ADE80"
                android:textSize="20sp"
                android:gravity="center"
                android:background="#1E2E1E"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_close_right"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="&#10005;"
                android:textColor="#606078"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_scenes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#2A2A3A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#FBBF24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Camadas"
                android:textColor="#F0F0F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/btn_layers_visibility"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="&#128065;"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#606078" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <include layout="@layout/item_layer_row" android:id="@+id/layer_personagem" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_3d" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_fundo" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_desenho" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_efeito" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_texto" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_audio" />

        </LinearLayout>

    </LinearLayout>

    <!-- OVERLAY ao abrir drawer -->
    <View
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone" />

</FrameLayout>
