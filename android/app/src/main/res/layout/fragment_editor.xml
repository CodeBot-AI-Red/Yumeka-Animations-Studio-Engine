<?xml version="1.0" encoding="utf-8"?>
<!--
    Editor YASE - Mobile-first
    Solucao para tela cheia no mobile:
    Paineis laterais sao DRAWERS — ficam fora da tela por padrao.
    O usuario os abre via botoes na topbar.
    Apenas canvas + ferramentas verticais ficam visiveis por padrao.

    Conceitos separados:
      Cena     = secao do episodio (logica, sem pasta fisica)
      Frame    = quadro da Cena selecionada
      Keyframe = ponto de animacao dentro de um Frame
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F13">

    <!-- CAMADA BASE: topbar + ferramentas + canvas + toolbar inferior -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOPBAR -->
        <LinearLayout
            android:id="@+id/editor_topbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Voltar -->
            <TextView
                android:id="@+id/btn_editor_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#8592;"
                android:textColor="#A0A0B8"
                android:textSize="20sp"
                android:gravity="center" />

            <!-- Toggle painel esquerdo (Frames/Keyframes) -->
            <TextView
                android:id="@+id/btn_toggle_left"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9776;"
                android:textColor="#9B6DFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginStart="2dp" />

            <!-- Nome projeto + episodio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/txt_project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projeto"
                    android:textColor="#F0F0F5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/txt_season_episode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temporada 1 Episodio 1"
                    android:textColor="#606078"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- Tab Quadros -->
            <TextView
                android:id="@+id/tab_quadros"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Quadros"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="#9B6DFF"
                android:layout_marginEnd="3dp" />

            <!-- Tab 3D -->
            <TextView
                android:id="@+id/tab_3d"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="3D"
                android:textColor="#A0A0B8"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="#22222E"
                android:layout_marginEnd="4dp" />

            <!-- Play -->
            <TextView
                android:id="@+id/btn_play"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="&#9654;"
                android:textColor="#F0F0F5"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#2A2A3A"
                android:layout_marginEnd="3dp" />

            <!-- Toggle painel direito (Cenas/Camadas) -->
            <TextView
                android:id="@+id/btn_toggle_right"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#9783;"
                android:textColor="#4ADE80"
                android:textSize="16sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- FERRAMENTAS VERTICAIS (coluna fina, sempre visivel) -->
        <LinearLayout
            android:id="@+id/panel_tools"
            android:layout_width="40dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:background="#12121C"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/editor_topbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_toolbar">

            <TextView android:id="@+id/tool_select"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#8630;" android:textColor="#FFFFFF" android:textSize="15sp"
                android:gravity="center" android:background="#9B6DFF"
                android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tool_move"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#10021;" android:textColor="#A0A0B8" android:textSize="15sp"
                android:gravity="center" android:background="#1E1E2E"
                android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tool_rotate"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#8635;" android:textColor="#A0A0B8" android:textSize="15sp"
                android:gravity="center" android:background="#1E1E2E"
                android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tool_crop"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#9634;" android:textColor="#A0A0B8" android:textSize="13sp"
                android:gravity="center" android:background="#1E1E2E"
                android:layout_marginBottom="6dp" />

            <View android:layout_width="22dp" android:layout_height="0.5dp"
                android:background="#2A2A3A" android:layout_marginBottom="6dp" />

            <TextView android:id="@+id/tool_brush"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#9998;" android:textColor="#A0A0B8" android:textSize="15sp"
                android:gravity="center" android:background="#1E1E2E"
                android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tool_color"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#9679;" android:textColor="#4ADE80" android:textSize="18sp"
                android:gravity="center" android:background="#1E1E2E"
                android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tool_fill"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#128024;" android:textColor="#A0A0B8" android:textSize="13sp"
                android:gravity="center" android:background="#1E1E2E"
                android:layout_marginBottom="4dp" />

            <TextView android:id="@+id/tool_more"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="&#8943;" android:textColor="#606078" android:textSize="15sp"
                android:gravity="center" android:background="#12121C" />

        </LinearLayout>

        <!-- CANVAS CENTRAL (ocupa todo o espaco disponivel) -->
        <FrameLayout
            android:id="@+id/canvas_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#111118"
            app:layout_constraintTop_toBottomOf="@id/editor_topbar"
            app:layout_constraintStart_toEndOf="@id/panel_tools"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_toolbar">

            <View
                android:id="@+id/canvas_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#111118" />

            <!-- Botoes flutuantes no rodape do canvas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="6dp">

                <TextView
                    android:id="@+id/btn_alinhar_ia"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="&#128247;  alinhar com IA"
                    android:textColor="#F0F0F5"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="#1E1E2E"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btn_editar_video"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="&#127909;  Editar Video"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#9B6DFF" />

            </LinearLayout>

        </FrameLayout>

        <!-- TOOLBAR INFERIOR SCROLLAVEL -->
        <HorizontalScrollView
            android:id="@+id/bottom_toolbar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="#12121C"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/panel_tools"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Cada item da toolbar inferior -->
                <LinearLayout android:id="@+id/btool_modelos"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#128432;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Modelos" android:textColor="#9B6DFF" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_elementos"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#10029;" android:textSize="16sp" android:gravity="center"
                        android:textColor="#A0A0B8" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Elementos" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_texto"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="T" android:textSize="16sp" android:gravity="center"
                        android:textColor="#A0A0B8" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Texto" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_galeria"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#128247;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Galeria" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_camera"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#127909;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Camera" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_efeitos"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#10024;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Efeitos" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_particulas"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#10052;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Particulas" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_luz"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#9728;" android:textSize="16sp" android:gravity="center"
                        android:textColor="#FBBF24" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Luz" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_sombras"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#9681;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Sombras" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_fundo"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#127757;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Fundo" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_personagem"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#127939;" android:textSize="16sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Personagem" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btool_mais"
                    android:layout_width="56dp" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&#8943;" android:textSize="16sp" android:gravity="center"
                        android:textColor="#606078" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mais" android:textColor="#606078" android:textSize="8sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER ESQUERDO: Keyframes + Frames — desliza sobre o canvas -->
    <LinearLayout
        android:id="@+id/panel_left"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F0151520"
        android:elevation="8dp"
        android:translationX="-260dp"
        android:visibility="invisible">

        <!-- Header Keyframes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#9B6DFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Keyframes"
                android:textColor="#F0F0F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <!-- Fechar drawer -->
            <TextView
                android:id="@+id/btn_close_left"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="&#10005;"
                android:textColor="#606078"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_add_keyframe"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="+ Adicionar keyframe"
            android:textColor="#F0F0F5"
            android:textSize="12sp"
            android:gravity="center"
            android:background="#9B6DFF"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/btn_del_keyframe"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="Excluir keyframe"
            android:textColor="#A0A0B8"
            android:textSize="12sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/btn_choose_keyframe"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="Escolher keyframes"
            android:textColor="#A0A0B8"
            android:textSize="12sp"
            android:gravity="center"
            android:background="#1E1E2E"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#2A2A3A" />

        <!-- Lista de Frames -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_frames"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/btn_add_frame"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="+ Adicionar Frame"
            android:textColor="#9B6DFF"
            android:textSize="12sp"
            android:gravity="center"
            android:background="#1A1A2A" />

    </LinearLayout>

    <!-- DRAWER DIREITO: Cenas + Camadas — desliza pelo lado direito -->
    <LinearLayout
        android:id="@+id/panel_right"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F0151520"
        android:elevation="8dp"
        android:layout_gravity="end"
        android:translationX="260dp"
        android:visibility="invisible">

        <!-- Header Cenas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#4ADE80" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cenas"
                android:textColor="#F0F0F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/btn_add_scene"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="+"
                android:textColor="#4ADE80"
                android:textSize="20sp"
                android:gravity="center"
                android:background="#1E2E1E"
                android:layout_marginEnd="6dp" />

            <!-- Fechar drawer -->
            <TextView
                android:id="@+id/btn_close_right"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="&#10005;"
                android:textColor="#606078"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Lista de Cenas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_scenes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#2A2A3A" />

        <!-- Header Camadas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A2E"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#FBBF24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Camadas"
                android:textColor="#F0F0F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/btn_layers_visibility"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="&#128065;"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#606078" />

        </LinearLayout>

        <!-- Camadas fixas do episodio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <include layout="@layout/item_layer_row" android:id="@+id/layer_personagem" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_3d" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_fundo" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_desenho" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_efeito" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_texto" />
            <include layout="@layout/item_layer_row" android:id="@+id/layer_audio" />

        </LinearLayout>

    </LinearLayout>

    <!-- OVERLAY escuro ao abrir qualquer drawer -->
    <View
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone" />

</FrameLayout>
