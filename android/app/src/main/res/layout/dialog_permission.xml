<?xml version="1.0" encoding="utf-8"?>
<!--
    Hub: Permissao de Storage
    Envolto em ScrollView para que nao seja cortado em telas 16:9 landscape
    onde a altura disponivel e menor que a altura total do conteudo.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#121212"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A1A2E"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/dialog_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="&#128193;"
                android:textSize="28sp"
                android:gravity="center"
                android:background="#1E3A5F"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage access needed"
                android:textColor="#90CAF9"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="To read your animation projects"
                android:textColor="#5C8AB5"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="&#10003;"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="#1B2E1B"
                    android:layout_marginEnd="10dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Creates your project folder"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documents / Yumeka Animations"
                        android:textColor="#666666"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="&#10003;"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="#1B2E1B"
                    android:layout_marginEnd="10dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lists your projects automatically"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No manual setup needed"
                        android:textColor="#666666"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="&#10003;"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="#1B2E1B"
                    android:layout_marginEnd="10dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Only reads Yumeka Animations"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your other files stay private"
                        android:textColor="#666666"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#2A2A2A"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/btn_allow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Allow storage access"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Not now"
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#111111" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
