<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1A1A1A"
    android:padding="12dp"
    android:layout_marginBottom="1dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/project_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#127916;"
            android:textSize="18sp"
            android:gravity="center"
            android:background="#252525" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/project_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#444444"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/project_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF6B35"
                android:textSize="10sp"
                android:background="#1F120A"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/project_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#333333"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/project_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF4444"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/project_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#9733;"
        android:textColor="#FFB347"
        android:textSize="14sp"
        android:layout_marginEnd="6dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#8250;"
        android:textColor="#2A2A2A"
        android:textSize="22sp" />

</LinearLayout>
